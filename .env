# Never upload .env files to GitHub. I only added it here so anyone cloning this repo doesn't have to make one.
# .env files typically contain senstive data such as API keys, IP addresses, passwords, etc. So it's important to
# add .env to your .gitignore to esnure whenever new changes are pushed, the .env is not included.
VT_API_KEY = "[YOUR-VIRUS-TOTAL-API-KEY]"
IPDB_API_KEY = "[YOUR-ABUSE-IPDB-API-KEY]"
